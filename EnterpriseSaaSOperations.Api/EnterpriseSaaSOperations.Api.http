@HostAddress = https://localhost:7282

###
POST {{HostAddress}}/api/organizations
Content-Type: application/json

{
  "organizationName": "Nexora Labs - Onboarding Test",
  "ownerName": "Test Owner",
  "email": "owner.onboarding.test@example.com",
  "password": "Nexora-Onboard#2026"
}

###
# @name login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "owner.onboarding.test@example.com",
  "password": "Nexora-Onboard#2026"
}

###
GET {{HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###
POST {{HostAddress}}/api/requests
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Request sample",
  "description": "Unable to connect to the test.",
  "priority": "High"
}

###
GET {{HostAddress}}/api/requests/3
Authorization: Bearer {{login.response.body.$.accessToken}}

###
POST {{HostAddress}}/api/organizations
Content-Type: application/json

{
  "organizationName": "Architecture Verification Org",
  "ownerName": "Architecture Test Owner",
  "email": "architecture-owner-20261016@example.com",
  "password": "Smoke-Test#2026"
}

### Login
# @name architectureLogin
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "architecture-owner-20261016@example.com",
  "password": "Smoke-Test#2026"
}

### Get authenticated user context
GET {{HostAddress}}/api/auth/me
Authorization: Bearer {{architectureLogin.response.body.$.accessToken}}

### Create operational request
# @name architectureRequest
POST {{HostAddress}}/api/requests
Authorization: Bearer {{architectureLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Architecture Verification Request",
  "description": "Verify the refactored request workflow.",
  "priority": "Medium"
}

### Retrieve operational request
GET {{HostAddress}}/api/requests/{{architectureRequest.response.body.$.id}}
Authorization: Bearer {{architectureLogin.response.body.$.accessToken}}

###
# @name createTeam
POST {{HostAddress}}/api/teams
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
    "name": "Engineering"
}

###
GET {{HostAddress}}/api/teams/1
Authorization: Bearer {{login.response.body.$.accessToken}}

###
GET {{HostAddress}}/api/teams?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.accessToken}}

### 
PUT {{HostAddress}}/api/teams/1
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
    "name": "Platform Engineering"
}